#!/usr/bin/env python3
# Copyright 2025 edge_vlm_ros contributors
#
# vlm_multi_frame_client — multi-frame VLM inference client for benchmarking.
#
# Invokes edge_vlm_cli (the repo's IPC-based CLI, installed alongside this
# script) to run one multi-image inference against a running edge_vlm_server
# and writes a structured JSON result artifact.  Suitable for automated
# multi-frame latency characterisation via the VLM multi-frame benchmark runner.
#
# The script is installed into lib/edge_vlm_ros/ so it is available as:
#   ros2 run edge_vlm_ros vlm_multi_frame_client ...
#
# Usage:
#   vlm_multi_frame_client \
#       --socket PATH           # IPC socket of edge_vlm_server (default: /tmp/edge_vlm.sock)
#       --image  PATH           # input image (JPEG/PNG); repeat for multiple frames
#       --prompt TEXT           # prompt string
#       --max-tokens N          # maximum output tokens (passed as --max-generate-length)
#       --output PATH           # where to write the JSON result artifact
#       [--timeout N]           # seconds before the call is aborted (default: 120)
#
# Multiple images are passed to edge_vlm_cli as repeated --image arguments in
# temporal order.  edge_vlm_cli packs all images into a single kSchemaFlagMultiImage
# IPC request so the running edge_vlm_server receives them together.
#
# JSON result artifact fields:
#   success            bool     — true if edge_vlm_cli exited 0
#   error              str|null — error description when success is false
#   output_text        str|null — inference response text (stdout of edge_vlm_cli)
#   output_tokens      int|null — actual output token count from the backend if available; null otherwise
#   output_words       int|null — whitespace-delimited word count of output_text (not a token count)
#   inference_seconds  float|null — wall time reported by edge_vlm_cli on stderr
#   client_latency_ms  int      — end-to-end wall time measured by this script
#   frame_count        int      — number of image frames submitted

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path


def _find_edge_vlm_cli() -> str:
    """Return the path to edge_vlm_cli installed alongside this script.

    Mirrors the discovery logic in vlm_single_shot_client so both scripts
    work correctly under ``colcon build --symlink-install`` and plain
    ``colcon build``.
    """
    # 1. Prefer the directory of the invocation path (install dir for ros2 run).
    invocation_dir = Path(os.path.abspath(sys.argv[0])).parent
    candidate = invocation_dir / "edge_vlm_cli"
    if candidate.is_file() and os.access(str(candidate), os.X_OK):
        return str(candidate)

    # 2. Fall back to PATH-based search.
    found = shutil.which("edge_vlm_cli")
    if found:
        return found

    raise RuntimeError(
        f"edge_vlm_cli not found alongside {sys.argv[0]} or on PATH. "
        "Ensure edge_vlm_ros is built and installed (colcon build)."
    )


def _parse_inference_seconds(stderr: str) -> float | None:
    """Extract the 'Inference time: X seconds' value from edge_vlm_cli stderr."""
    for line in stderr.splitlines():
        if line.startswith("Inference time:"):
            try:
                return float(line.split(":")[1].strip().split()[0])
            except (IndexError, ValueError):
                pass
    return None


def _parse_temporal_fields(stderr: str) -> tuple[str | None, str | None, bool | None]:
    requested: str | None = None
    runtime_encoding: str | None = None
    fallback: bool | None = None
    for line in stderr.splitlines():
        if line.startswith("Requested sequence type:"):
            requested = line.split(":", 1)[1].strip() or None
        elif line.startswith("Runtime temporal encoding:"):
            runtime_encoding = line.split(":", 1)[1].strip() or None
        elif line.startswith("Temporal fallback used:"):
            val = line.split(":", 1)[1].strip().lower()
            if val in {"true", "false"}:
                fallback = val == "true"
    return requested, runtime_encoding, fallback


def _parse_timestamps_csv(value: str) -> list[float]:
    if not value.strip():
        return []
    out: list[float] = []
    for item in value.split(","):
        token = item.strip()
        if not token:
            raise ValueError("empty timestamp item in --frame-timestamps-sec")
        out.append(float(token))
    return out


def _validate_temporal_contract(
    sequence_type: str,
    fps: float | None,
    frame_timestamps_sec: list[float],
    frame_count: int,
) -> None:
    if sequence_type == "images" and (fps is not None or frame_timestamps_sec):
        raise ValueError("sequence_type=images must not include --fps or --frame-timestamps-sec")
    if fps is not None and fps <= 0:
        raise ValueError("--fps must be > 0")
    if frame_timestamps_sec:
        if len(frame_timestamps_sec) != frame_count:
            raise ValueError(
                f"--frame-timestamps-sec length ({len(frame_timestamps_sec)}) must match frame count ({frame_count})"
            )
        for i in range(1, len(frame_timestamps_sec)):
            if not frame_timestamps_sec[i] > frame_timestamps_sec[i - 1]:
                raise ValueError("--frame-timestamps-sec must be strictly increasing")
    if fps is not None and len(frame_timestamps_sec) >= 2:
        expected_dt = 1.0 / fps
        for i in range(1, len(frame_timestamps_sec)):
            dt = frame_timestamps_sec[i] - frame_timestamps_sec[i - 1]
            if abs(dt - expected_dt) > 1e-3:
                raise ValueError(
                    f"--fps conflicts with --frame-timestamps-sec spacing at index {i}"
                )


def _render_timestamps(
    image_paths: list[str],
    frame_timestamps_sec: list[float],
) -> tuple[list[str], tempfile.TemporaryDirectory[str]]:
    try:
        import cv2  # type: ignore
    except Exception as exc:  # pragma: no cover - exercised only when rendering enabled
        raise RuntimeError("timestamp rendering requested but OpenCV (cv2) is unavailable") from exc

    tmpdir = tempfile.TemporaryDirectory(prefix="vlm_rendered_ts_")
    rendered_paths: list[str] = []
    for idx, image_path in enumerate(image_paths):
        img = cv2.imread(image_path, cv2.IMREAD_COLOR)
        if img is None:
            tmpdir.cleanup()
            raise RuntimeError(f"failed to decode image for timestamp rendering: {image_path}")
        ts_text = f"{frame_timestamps_sec[idx]:.2f} s"
        cv2.putText(
            img,
            ts_text,
            (16, 32),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.85,
            (255, 255, 255),
            2,
            cv2.LINE_AA,
        )
        out_path = Path(tmpdir.name) / f"frame_{idx:04d}.jpg"
        if not cv2.imwrite(str(out_path), img):
            tmpdir.cleanup()
            raise RuntimeError(f"failed to write rendered timestamp frame: {out_path}")
        rendered_paths.append(str(out_path))
    return rendered_paths, tmpdir


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Multi-frame VLM inference client.  Requires edge_vlm_server to be "
            "running and reachable on the specified IPC socket.  Passes all images "
            "in a single multi-frame IPC request via edge_vlm_cli."
        ),
    )
    parser.add_argument(
        "--socket",
        default="/tmp/edge_vlm.sock",
        help="Path to edge_vlm_server IPC socket (default: /tmp/edge_vlm.sock)",
    )
    parser.add_argument(
        "--image",
        dest="images",
        action="append",
        required=True,
        metavar="PATH",
        help="Path to an input image; repeat for multiple frames in temporal order",
    )
    parser.add_argument("--prompt", required=True, help="Prompt text for the VLM")
    parser.add_argument(
        "--max-tokens",
        type=int,
        required=True,
        metavar="N",
        help="Maximum output token budget (forwarded as --max-generate-length)",
    )
    parser.add_argument(
        "--output",
        required=True,
        help="File path where the JSON result artifact will be written",
    )
    parser.add_argument(
        "--timeout",
        type=int,
        default=120,
        metavar="N",
        help="Abort after N seconds (default: 120)",
    )
    parser.add_argument(
        "--sequence-type",
        choices=["images", "temporal_images", "video"],
        default="images",
        help="Input sequence contract (default: images)",
    )
    parser.add_argument(
        "--fps",
        type=float,
        default=None,
        help="Optional FPS metadata for temporal_images/video requests",
    )
    parser.add_argument(
        "--frame-timestamps-sec",
        default=None,
        help="Optional comma-separated per-frame timestamps in seconds",
    )
    parser.add_argument(
        "--render-timestamps",
        action="store_true",
        help="Render visible timestamps on frames (experimental control)",
    )
    args = parser.parse_args()
    try:
        explicit_timestamps = (
            _parse_timestamps_csv(args.frame_timestamps_sec)
            if args.frame_timestamps_sec is not None
            else []
        )
        _validate_temporal_contract(
            sequence_type=args.sequence_type,
            fps=args.fps,
            frame_timestamps_sec=explicit_timestamps,
            frame_count=len(args.images),
        )
    except ValueError as exc:
        print(f"vlm_multi_frame_client: {exc}", file=sys.stderr)
        return 2

    try:
        cli = _find_edge_vlm_cli()
    except RuntimeError as exc:
        print(f"vlm_multi_frame_client: {exc}", file=sys.stderr)
        return 2

    effective_timestamps = list(explicit_timestamps)
    if args.render_timestamps and not effective_timestamps:
        if args.fps is not None:
            effective_timestamps = [i / args.fps for i in range(len(args.images))]
        else:
            effective_timestamps = [float(i) for i in range(len(args.images))]

    images_for_inference = list(args.images)
    render_tmpdir: tempfile.TemporaryDirectory[str] | None = None
    if args.render_timestamps:
        try:
            images_for_inference, render_tmpdir = _render_timestamps(
                images_for_inference,
                effective_timestamps if effective_timestamps else [float(i) for i in range(len(args.images))],
            )
        except RuntimeError as exc:
            print(f"vlm_multi_frame_client: {exc}", file=sys.stderr)
            return 2

    # Build command: one --image per frame so edge_vlm_cli sends a single
    # kSchemaFlagMultiImage IPC request carrying all frames together.
    cmd = [
        cli,
        "--socket", args.socket,
    ]
    for img_path in images_for_inference:
        cmd += ["--image", img_path]
    cmd += ["--sequence-type", args.sequence_type]
    if args.fps is not None:
        cmd += ["--fps", str(args.fps)]
    if explicit_timestamps:
        cmd += ["--frame-timestamps-sec", ",".join(f"{ts:.9g}" for ts in explicit_timestamps)]
    cmd += [
        "--prompt", args.prompt,
        "--max-generate-length", str(args.max_tokens),
    ]

    t_start = time.monotonic()
    try:
        proc = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=args.timeout,
        )
    except subprocess.TimeoutExpired:
        if render_tmpdir is not None:
            render_tmpdir.cleanup()
        elapsed_ms = round((time.monotonic() - t_start) * 1000.0)
        result: dict = {
            "success": False,
            "error": f"timeout after {args.timeout}s",
            "output_text": None,
            "output_tokens": None,
            "output_words": None,
            "inference_seconds": None,
            "client_latency_ms": elapsed_ms,
            "frame_count": len(args.images),
            "sequence_type": args.sequence_type,
            "fps": args.fps,
            "frame_timestamps_sec": explicit_timestamps or None,
            "rendered_timestamps": args.render_timestamps,
            "requested_sequence_type": None,
            "runtime_temporal_encoding": None,
            "temporal_fallback_used": None,
        }
        Path(args.output).write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
        print(
            f"vlm_multi_frame_client: timed out after {args.timeout}s",
            file=sys.stderr,
        )
        return 1

    elapsed_ms = round((time.monotonic() - t_start) * 1000.0)
    if render_tmpdir is not None:
        render_tmpdir.cleanup()
    success = proc.returncode == 0
    output_text: str | None = proc.stdout.strip() if success else None
    # output_tokens: real token count from backend when available; null otherwise.
    # edge_vlm_cli does not currently expose a token count, so this is always null.
    output_tokens: int | None = None
    # output_words: whitespace-delimited word count — stored separately, not as token count.
    output_words: int | None = len(output_text.split()) if output_text else None
    inference_seconds = _parse_inference_seconds(proc.stderr)
    requested_sequence_type, runtime_temporal_encoding, temporal_fallback_used = _parse_temporal_fields(
        proc.stderr
    )

    error_msg: str | None
    if success:
        error_msg = None
    else:
        stderr_snippet = proc.stderr.strip()[:200]
        error_msg = f"edge_vlm_cli exited {proc.returncode}: {stderr_snippet}"

    result = {
        "success": success,
        "error": error_msg,
        "output_text": output_text,
        "output_tokens": output_tokens,
        "output_words": output_words,
        "inference_seconds": inference_seconds,
        "client_latency_ms": elapsed_ms,
        "frame_count": len(args.images),
        "sequence_type": args.sequence_type,
        "fps": args.fps,
        "frame_timestamps_sec": explicit_timestamps or None,
        "rendered_timestamps": args.render_timestamps,
        "requested_sequence_type": requested_sequence_type,
        "runtime_temporal_encoding": runtime_temporal_encoding,
        "temporal_fallback_used": temporal_fallback_used,
    }
    Path(args.output).write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")

    return 0 if success else 1


if __name__ == "__main__":
    sys.exit(main())
