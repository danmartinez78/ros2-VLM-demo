{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vlm_latency_record.schema.json",
  "title": "VLM Latency Characterization Record",
  "description": "Per-inference record emitted by run_vlm_latency_benchmark.sh and consumed by vlm_latency_report.py. Fields unavailable from the runtime are represented as null — they are never inferred or fabricated.",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "recorded_at",
    "condition",
    "path",
    "image_id",
    "prompt_id",
    "max_output_tokens",
    "success",
    "total_latency_ms"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1", "description": "Schema version for forward-compatibility checks."},
    "record_type": {"type": "string", "enum": ["inference"], "description": "Fixed discriminator field."},
    "run_id": {"type": "string", "description": "Unique run identifier shared across records in one benchmark invocation."},
    "recorded_at": {"type": "string", "format": "date-time", "description": "ISO 8601 wall-clock timestamp when this record was written."},
    "condition": {"type": "string", "description": "Experiment condition label from the matrix (e.g. A, B, C, D, E).", "pattern": "^[A-Z][0-9]?$"},
    "path": {"type": "string", "enum": ["direct", "ipc"], "description": "Invocation path: direct native-runtime invocation or persistent IPC server."},
    "lifecycle_semantics": {"type": ["string", "null"], "enum": ["cold_start", "persistent", null], "description": "Lifecycle phase measured; null for legacy records."},
    "image_id": {"type": "string", "description": "Stable identifier for the input image."},
    "image_path": {"type": ["string", "null"], "description": "Input image path."},
    "image_width_px": {"type": ["integer", "null"], "description": "Effective image width in pixels."},
    "image_height_px": {"type": ["integer", "null"], "description": "Effective image height in pixels."},
    "content_hash": {"type": ["string", "null"], "description": "Short SHA-256 prefix of image content."},
    "prompt_id": {"type": "string", "description": "Prompt style identifier, e.g. terse_id, compact_scene_json, scene_description."},
    "prompt_hash": {"type": ["string", "null"], "description": "Short SHA-256 prefix of the exact prompt text."},
    "max_output_tokens": {"type": "integer", "minimum": 1},
    "actual_output_tokens": {"type": ["integer", "null"]},
    "finish_reason": {"type": ["string", "null"]},
    "output_text": {"type": ["string", "null"]},
    "output_words": {"type": ["integer", "null"]},
    "inference_seconds": {"type": ["number", "null"]},
    "success": {"type": "boolean"},
    "error": {"type": ["string", "null"]},
    "cold_start_total_ms": {"type": ["number", "null"]},
    "total_latency_ms": {"type": ["number", "null"]},
    "vision_encoder_ms": {"type": ["number", "null"]},
    "prefill_ms": {"type": ["number", "null"]},
    "ttft_ms": {"type": ["number", "null"]},
    "decode_ms": {"type": ["number", "null"]},
    "decode_tokens_per_sec": {"type": ["number", "null"]},
    "average_time_per_token_ms": {"type": ["number", "null"]},
    "llm_generation_total_gpu_time_ms": {"type": ["number", "null"]},
    "native_response_path": {"type": ["string", "null"]},
    "native_profile_path": {"type": ["string", "null"]},
    "ipc_result_path": {"type": ["string", "null"]},
    "model_name": {"type": ["string", "null"]},
    "iteration": {"type": "integer", "minimum": 0},
    "warmup": {"type": "boolean"},
    "tegrastats": {
      "type": ["object", "null"],
      "properties": {
        "emc_pct": {"type": ["number", "null"]},
        "gr3d_pct": {"type": ["number", "null"]},
        "module_power_w": {"type": ["number", "null"]},
        "cpu_hotspot_pct": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    }
  }
}
