{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "native_benchmark_result.schema.json",
  "title": "Native TensorRT Edge-LLM Benchmark Manifest",
  "description": "Manifest written by run_native_benchmarks.sh. Points to native tool artifact files and records run metadata. Native tool outputs are preserved verbatim; timing logic is NOT reimplemented.",
  "type": "object",
  "required": ["schema_version", "run_id", "recorded_at", "metadata"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1",
      "description": "Schema version for forward-compatibility checks."
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this benchmark run (timestamp-based)."
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the run was executed."
    },
    "metadata": {
      "type": "object",
      "description": "Platform, model, and run configuration metadata.",
      "required": ["arch"],
      "properties": {
        "hostname": {"type": ["string", "null"]},
        "arch": {"type": "string"},
        "os_release": {"type": ["string", "null"]},
        "l4t_release": {"type": ["string", "null"]},
        "jetpack_version": {"type": ["string", "null"]},
        "cuda_version": {"type": ["string", "null"]},
        "tensorrt_version": {"type": ["string", "null"]},
        "gpu_name": {"type": ["string", "null"]},
        "gpu_compute_capability": {"type": ["string", "null"]},
        "nvpmodel_mode": {"type": ["string", "null"]},
        "model_name": {"type": ["string", "null"]},
        "engine_profile_id": {"type": ["string", "null"]},
        "quantization": {"type": ["string", "null"]},
        "llm_engine_dir": {"type": ["string", "null"]},
        "multimodal_engine_dir": {"type": ["string", "null"]},
        "engine_manifest_path": {"type": ["string", "null"]},
        "engine_manifest_sha256": {"type": ["string", "null"]},
        "engine_identity": {"type": ["string", "null"]},
        "engine_manifest_status": {"type": ["string", "null"]},
        "engine_provenance": {"type": ["object", "null"]},
        "edge_llm_commit": {"type": ["string", "null"]},
        "edge_llm_version_tag": {"type": ["string", "null"]},
        "max_generate_length": {"type": ["integer", "null"]},
        "warmup_iterations": {"type": ["integer", "null"]},
        "measured_iterations": {"type": ["integer", "null"]},
        "input_image_path": {"type": ["string", "null"]},
        "input_vlm_json": {"type": ["string", "null"]}
      }
    },
    "engine_provenance": {
      "type": ["object", "null"],
      "description": "Canonical engine provenance resolved before benchmark execution."
    },
    "llm_bench_prefill": {
      "type": ["string", "null"],
      "description": "Relative path to llm_bench --mode prefill output file."
    },
    "llm_bench_decode": {
      "type": ["string", "null"],
      "description": "Relative path to llm_bench --mode decode output file."
    },
    "llm_bench_visual": {
      "type": ["string", "null"],
      "description": "Relative path to llm_bench --mode visual output file."
    },
    "llm_inference_profile": {
      "type": ["string", "null"],
      "description": "Relative path to llm_inference --dumpProfile output file."
    },
    "llm_inference_output": {
      "type": ["string", "null"],
      "description": "Relative path to llm_inference --outputFile JSON output."
    },
    "skipped_modes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Benchmark modes that were skipped in this run."
    },
    "errors": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Non-fatal errors encountered during the run."
    }
  }
}
