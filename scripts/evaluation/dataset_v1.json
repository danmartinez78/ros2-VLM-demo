        "hazard_recognition": {
          "required_observations": [
            ["clear", "no immediate hazard"]
          ],
          "forbidden_observations": [
            "collision"
          ]
        },
        "scene_state": {
          "required_observations": [
            ["indoor", "warehouse"]
          ]
        }
      },
      "unsupported_claim_terms": [
        "fire",
        "smoke"
      ]
    },
    {
